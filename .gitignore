# Top-level junctions into Dropbox RP6 (leading slash anchors to repo root
# so RP7/scripts, RP7/data, RP7/output are NOT matched by these rules)
/scripts/
/data/
/output/

# Paper (added manually, not symlinked)
# paper/ is tracked

# RP7 local working copy: track scripts and generated tables/figures,
# drop binaries, run logs, and the data junctions (M4: data_real points
# at the Dropbox real-values data folder for the values(nominal|real)
# switch in 0_path_config.do)
RP7/data/
RP7/data_real/
RP7/scripts/logs/
RP7/output/*.ster
RP7/output/**/*.ster
RP7/output/*.smcl
RP7/output/**/*.smcl
RP7/output/*.log
RP7/output/**/*.log
RP7/output/*.gph
RP7/output/**/*.gph

# rerun_workdir is a local Stata working directory: track the .do
# scripts and the small .csv summaries (already covered by general
# rules), but skip the heavy estimation binaries.
explorations/python-grc/rerun_workdir/output/
explorations/python-grc/rerun_workdir/logs/

# Transient test artifacts (e.g. addlinespace investigation, minimal repros)
RP7/output/test_*

# Headlines cache: text CSVs with the actual headline values per fit.
# Tracked (not ignored) so git records the value history per re-fit ---
# .ster files are binary and can't be diff'd, but these CSVs can.

# Dashboard cache-bootstrap profiling and run logs
tools/results_overview/profile_render.prof
tools/results_overview/scrape_bootstrap.log
tools/results_overview/render_with_cache.log

# Stata artifacts
*.log
*.smcl

# LaTeX artifacts
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.vrb
*.run.xml
*.bcf

# Python artifacts
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/

# Working documents (tracked); skip large PDFs in lit/
docs/lit/*.pdf

# Claude Code local state
.claude/state/
.claude/*.lock

# Cygwin / msys process crash dumps (Git Bash on Windows)
*.stackdump
